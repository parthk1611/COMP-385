# Intermediate tables are rebuilt by the build_* scripts; their audits are tracked.
data/interim/*.csv
data/interim/*.csv.gz
data/interim/*.geojson

# The cell table, CNN patches, fitted models and per-step scores are rebuilt by the
# spread_modeling scripts; their results and audits are tracked in docs/modeling/.
artifacts/

# The viewer page already contains this data; scripts/spread_viewer/export.py rebuilds both.
viewer/spread_viewer_data.js

