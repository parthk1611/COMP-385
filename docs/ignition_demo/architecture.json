  "cards": [
    {
      "dot": "cyan",
      "title": "Project purpose",
      "items": [
        "Rank historical ignition risk in Ontario and compare where an existing wildfire spreads between satellite passes.",
        "The two capabilities use separate datasets and targets. Ignition predictions do not initialize the current spread implementation."
      ]
    },
    {
      "dot": "emerald",
      "title": "What the interfaces actually use",
      "items": [
        "Ignition: the Python API loads the verified, frozen 40-iteration HGB and the corrected 36-predictor cache.",
        "Spread: the exported HTML embeds plain CNN and FBP predictions. It does not train models or call a live prediction API."
      ]
    },
    {
      "dot": "violet",
      "title": "Latest ignition development",
      "items": [
        "Retained research configuration: coordinate HGB, 80 iterations, mean development AP 0.006965525. Its saved refit is separate from the demo.",
        "Bayesian B9: AP 0.007055028 (+1.28%); paired whole-day uncertainty spans zero. No replacement of the demo or new blind 2019 test."
      ]
    },
    {
      "dot": "amber",
      "title": "Training, artifacts and scope",
      "items": [
        "Spread: fit and select on 2012–2020 fire years, then evaluate on 2021–2024. Ten learned models include eight per-cell variants and two CNNs.",
        "New model binaries are generated and absent on this checkout. The architecture shows implemented build paths, not local deployment readiness.",
        "Both products are retrospective. Spread uses observed reanalysis weather; final-perimeter footprint and fuel-repair limitations remain documented."
      ]
    }
  ]
}
